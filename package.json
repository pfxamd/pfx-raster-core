{
  "name": "@pfxamd/raster-core",
  "version": "0.4.0-alpha.1",
  "description": "Independent, reusable raster image processing core with safe transformations and validation.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "clean": "node -e \"import('node:fs').then(m=>m.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run test",
    "prepack": "npm run check",
    "benchmark": "npm run build && node dist/benchmarks/run.js",
    "benchmark:smoke": "npm run build && node dist/benchmarks/run.js --iterations=1 --smoke --json"
  },
  "dependencies": {
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
